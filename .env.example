# Tennis Bot Configuration
#
# Copy to .env and fill in. .env is gitignored.

# Discord bot token for the TENNIS application (required).
# Discord Developer Portal -> your tennis application -> Bot -> Token.
#
# It must be the tennis application's OWN token. On startup the bot does a global
# applicationCommands PUT, which REPLACES the command set of whichever application
# the token belongs to. Point it at another bot and you delete that bot's commands.
# The startup log prints the application id it resolved, so you can check.
#
# There is intentionally no DISCORD_TOKEN fallback, for the same reason.
TENNIS_BOT_TOKEN=your_tennis_bot_token_here

# api-tennis.com API key (optional, but required for ITF and Challenger players).
# tennis-data.co.uk covers ATP/WTA tour level only, and Kalshi lists mostly ITF and
# Challenger, so without this the majority of the live board has no statistics.
# Sign up at https://api-tennis.com and paste the key here.
API_TENNIS_KEY=your_api_tennis_key_here
